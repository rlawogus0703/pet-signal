# 이 파일을 복사해서 backend/.env 로 저장하고 값을 채우세요.  (copy .env.example .env)
# .env 는 .gitignore 에 있어서 GitHub 에 올라가지 않습니다.

# 공공데이터포털 '구조동물 조회 서비스' 일반 인증키 (Decoding 키 권장)
SERVICE_KEY=여기에_발급받은_인증키

# DB. 로컬 기본은 SQLite. Neon/PostgreSQL 예:
# DATABASE_URL=sqlite:///./petsignal.db
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# postgres:// 와 스키마가 없는 user:pass@host/db 형식도 서버가 자동으로 변환합니다.

# 수집 설정
# COLLECT_PAGES=2
# COLLECT_ROWS=100
# COLLECT_INTERVAL_MINUTES=60
# COLLECT_ON_STARTUP=true
# EMBED_IMAGES_ON_COLLECT=true

# CORS (비우면 GitHub Pages + localhost 기본값)
# CORS_ORIGINS=https://rlawogus0703.github.io,http://localhost,http://127.0.0.1
